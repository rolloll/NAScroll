<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel"
    android:padding="14dp"
    android:layout_marginBottom="8dp">
    <TextView android:id="@+id/typeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/accent2" android:textSize="12sp" />
    <TextView android:id="@+id/contentText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_primary" android:textSize="16sp" android:maxLines="3" android:ellipsize="end" />
    <TextView android:id="@+id/pathText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="middle" />
</LinearLayout>